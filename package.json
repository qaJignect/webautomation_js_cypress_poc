{
  "name": "cypresspoc",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:open": "npx cypress open",
    "cypress:run": "npx cypress run",
    "clean:reports": "rimraf cypress/reports/report.json cypress/reports/html",
    "merge:reports": "npm run clean:reports && npx mochawesome-merge \"cypress/reports/mochawesome_*.json\" > cypress/reports/report.json",
    "generate:html": "npx marge cypress/reports/report.json -f report -o cypress/reports/html",
    "test:report": "npm run cypress:run && npm run merge:reports && npm run generate:html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "cypress": "^15.11.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "cypress-xpath": "^2.0.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.0",
    "rimraf": "^6.0.1"
  }
}
